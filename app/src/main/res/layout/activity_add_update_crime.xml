<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add New Crime"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="24dp"/>

        <EditText
            android:id="@+id/et1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:padding="14dp"
            android:background="@drawable/search_background"
            android:hint="Crime ID (unique)" />

        <EditText
            android:id="@+id/et2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:padding="14dp"
            android:background="@drawable/search_background"
            android:hint="Month (e.g. 2018-05)" />

        <EditText
            android:id="@+id/et3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:padding="14dp"
            android:background="@drawable/search_background"
            android:hint="Reported by" />

        <EditText
            android:id="@+id/et4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:padding="14dp"
            android:background="@drawable/search_background"
            android:hint="Falls within" />

        <EditText
            android:id="@+id/et5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:padding="14dp"
            android:background="@drawable/search_background"
            android:hint="Longitude"
            android:inputType="numberDecimal|numberSigned"/>

        <EditText
            android:id="@+id/et6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:padding="14dp"
            android:background="@drawable/search_background"
            android:hint="Latitude"
            android:inputType="numberDecimal|numberSigned"/>

        <EditText
            android:id="@+id/et7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:padding="14dp"
            android:background="@drawable/search_background"
            android:hint="Location (e.g. On or near Park)" />

        <EditText
            android:id="@+id/et8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:padding="14dp"
            android:background="@drawable/search_background"
            android:hint="LSOA code" />

        <EditText
            android:id="@+id/et9"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:padding="14dp"
            android:background="@drawable/search_background"
            android:hint="LSOA name" />

        <EditText
            android:id="@+id/et10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:padding="14dp"
            android:background="@drawable/search_background"
            android:hint="Crime type" />

        <EditText
            android:id="@+id/et11"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:padding="14dp"
            android:background="@drawable/search_background"
            android:hint="Last outcome category" />

        <EditText
            android:id="@+id/et12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:padding="14dp"
            android:background="@drawable/search_background"
            android:hint="Context (usually empty)" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveCrime"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="SAVE CRIME"
            android:textSize="18sp"
            android:textStyle="bold"
            android:insetTop="8dp"
            android:insetBottom="8dp"/>

    </LinearLayout>
</ScrollView>